{
  "name": "lumine-mcp",
  "author": "lumine-code",
  "description": "Model Context Protocol server exposing editor tools to AI assistants.",
  "repository": "https://github.com/lumine-code/lumine-mcp",
  "bugs": {
    "url": "https://github.com/lumine-code/lumine-mcp/issues"
  },
  "keywords": [
    "ai",
    "claude",
    "llm",
    "model-context-protocol",
    "assistant",
    "bridge",
    "http"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../lumine-mcp/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationHooks": [
    "core:loaded-shell-environment"
  ],
  "providedServices": {
    "mcp.bridge": {
      "versions": {
        "1.0.0": "provideMcpBridge"
      }
    }
  },
  "consumedServices": {
    "mcp.tools": {
      "versions": {
        "^1.0.0": "consumeMcpTools"
      }
    }
  },
  "configSchema": {
    "autoStart": {
      "title": "Auto Start",
      "description": "Automatically start the MCP bridge server when Lumine opens",
      "type": "boolean",
      "default": true
    },
    "bridgePort": {
      "title": "Bridge Base Port",
      "description": "Base port for MCP bridge. Auto-increments for multiple windows (e.g., 3000, 3001, 3002)",
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "default": 3000
    },
    "listMode": {
      "title": "List Mode",
      "description": "How the tool list is interpreted: blacklist disables listed tools, greenlist enables only listed tools",
      "type": "string",
      "enum": [
        "blacklist",
        "greenlist"
      ],
      "default": "blacklist"
    },
    "toolList": {
      "title": "Tool List",
      "description": "MCP tool names interpreted as blacklist or greenlist depending on List Mode (managed via toggle-tools command)",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "CloseFile",
        "RemoveProjectPath"
      ]
    },
    "debugMode": {
      "title": "Debug Mode",
      "description": "Enable debug logging to console for troubleshooting",
      "type": "boolean",
      "default": false
    }
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#a201dae6a0ea6954cb9a905be4a718af697d9f78"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
